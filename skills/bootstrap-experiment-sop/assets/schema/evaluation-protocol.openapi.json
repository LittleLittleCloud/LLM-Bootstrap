{
  "openapi": "3.1.0",
  "info": {
    "title": "LLM Bootstrap evaluation protocol schemas",
    "version": "0.3.0",
    "summary": "Structural schemas for repository-owned evaluation definitions and result documents.",
    "description": "Machine-readable core of references/evaluation-protocol.md. This document defines no HTTP operations; the Schema Objects under components.schemas are the deliverable. Validate a definition at evaluations/<id>/evaluation.json against EvaluationDefinition and a result document against EvaluationResult with any JSON Schema 2020-12 validator.\n\nEvaluations are owned by the LLM Bootstrap repository. Experiments select one by EvaluationReference and never carry or change evaluation code. The prose protocol and the skills remain authoritative. A passing validation shows only the required shape. It does not show that scripts exist or match their hashes (the repository tests check that), that measurements are correct, or that arithmetic is consistent. Primitive schemas shared with the experiment protocol schema are kept identical, and a test enforces that."
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "paths": {},
  "components": {
    "schemas": {
      "Text": { "description": "Non-blank text.", "type": "string", "pattern": "\\S" },
      "Sha256": { "description": "Lowercase hexadecimal SHA-256 digest.", "type": "string", "pattern": "^[0-9a-f]{64}$" },
      "GitCommitSha": {
        "description": "Full 40-character Git commit SHA. Abbreviated SHAs, branches, and tags are not immutable revisions.",
        "type": "string",
        "pattern": "^[0-9a-f]{40}$"
      },
      "NullableText": { "type": ["string", "null"], "pattern": "\\S" },
      "NullableSha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
      "NullableCommit": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
      "NotApplicable": {
        "description": "Explicit declaration that a field does not apply to this experiment.",
        "type": "object",
        "additionalProperties": false,
        "required": ["not_applicable", "reason"],
        "properties": {
          "not_applicable": { "const": true },
          "reason": { "$ref": "#/components/schemas/Text" }
        }
      },
      "Unavailable": {
        "description": "A provider or historical detail that cannot be obtained. Never substitute a fabricated identifier.",
        "type": "object",
        "additionalProperties": false,
        "required": ["unavailable", "reason"],
        "properties": {
          "unavailable": { "const": true },
          "reason": { "$ref": "#/components/schemas/Text" }
        }
      },
      "NotObtained": {
        "description": "Marker for a metric that was not measured. A missing metric is never zero.",
        "const": "Not obtained"
      },
      "NoNullValues": {
        "description": "Matches any JSON value containing no null at any depth. Used to require that a frozen contract has no unresolved fields.",
        "anyOf": [
          { "type": "object", "additionalProperties": { "$ref": "#/components/schemas/NoNullValues" } },
          { "type": "array", "items": { "$ref": "#/components/schemas/NoNullValues" } },
          { "type": ["string", "number", "boolean"] }
        ]
      },
      "CommitOrUnavailable": {
        "anyOf": [{ "$ref": "#/components/schemas/GitCommitSha" }, { "$ref": "#/components/schemas/Unavailable" }]
      },
      "ScalarSettings": {
        "description": "Settings as scalar key-value pairs, such as sampling parameters or the precision, speculation, and caching settings used.",
        "type": "object",
        "minProperties": 1,
        "additionalProperties": { "type": ["string", "number", "boolean"] }
      },
      "HashedArtifact": {
        "description": "A named file, executable, kernel, image, or other artifact with its content hash.",
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sha256"],
        "properties": {
          "name": { "$ref": "#/components/schemas/Text" },
          "sha256": { "$ref": "#/components/schemas/Sha256" }
        }
      },
      "EvidenceRef": {
        "description": "Pointer to raw evidence. Local-only evidence is explicitly marked, carries a hash and an access limitation, and is never given a download URL.",
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["description", "access", "url", "sha256"],
            "properties": {
              "description": { "$ref": "#/components/schemas/Text" },
              "access": { "const": "public" },
              "url": { "type": "string", "format": "uri", "pattern": "^https://" },
              "sha256": { "$ref": "#/components/schemas/Sha256" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["description", "access", "sha256", "access_limitation"],
            "properties": {
              "description": { "$ref": "#/components/schemas/Text" },
              "access": { "const": "local-only" },
              "sha256": { "$ref": "#/components/schemas/Sha256" },
              "access_limitation": { "$ref": "#/components/schemas/Text" }
            }
          }
        ]
      },
      "EvaluationReference": {
        "description": "Pins an evaluation definition in the LLM Bootstrap repository by id, repository commit, and definition file hash.",
        "type": "object",
        "additionalProperties": false,
        "required": ["evaluation_id", "revision", "sha256"],
        "properties": {
          "evaluation_id": { "$ref": "#/components/schemas/EvaluationId" },
          "revision": { "$ref": "#/components/schemas/GitCommitSha" },
          "sha256": { "$ref": "#/components/schemas/Sha256" }
        }
      },
      "EvaluationId": {
        "description": "Kebab-case id that equals the directory name under evaluations/.",
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "EvaluationScript": {
        "description": "A script or code file that carries out part of the evaluation. It lives inside the evaluation's own directory in this repository and is checked against its hash before use.",
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "path", "sha256"],
        "properties": {
          "role": { "enum": ["driver", "assertion-evaluator", "dependency-lock"] },
          "path": {
            "description": "Relative to evaluations/<evaluation_id>/. Absolute paths and parent traversal are not allowed.",
            "type": "string",
            "pattern": "^(?!/)(?!.*\\.\\.)[^\\\\]+$"
          },
          "sha256": { "$ref": "#/components/schemas/Sha256" }
        }
      },
      "DatasetPin": {
        "description": "An external dataset, pinned by the hashes of the files the evaluation reads. The driver refuses a file that does not match.",
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "source", "repository", "files"],
        "properties": {
          "name": { "$ref": "#/components/schemas/Text" },
          "source": { "enum": ["modelscope"] },
          "repository": { "$ref": "#/components/schemas/Text" },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "sha256"],
              "properties": {
                "path": { "$ref": "#/components/schemas/Text" },
                "sha256": { "$ref": "#/components/schemas/Sha256" }
              }
            }
          }
        }
      },
      "ThroughputPlanItem": {
        "description": "One throughput workload: an EvalScope perf shape run at one or more concurrency levels. Prompts are random tokens of exactly input_tokens, and every request must produce exactly output_tokens.",
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "input_tokens", "output_tokens", "levels"],
        "properties": {
          "id": { "$ref": "#/components/schemas/Text" },
          "kind": { "enum": ["prefill", "decode", "concurrency", "multi-turn"] },
          "input_tokens": { "description": "Prompt tokens of each request. For a multi-turn workload, the tokens added by each turn.", "type": "integer", "minimum": 1 },
          "output_tokens": { "type": "integer", "minimum": 1 },
          "turns": { "description": "Turns per conversation of a multi-turn workload.", "type": "integer", "minimum": 2 },
          "timeout_seconds": { "type": "number", "exclusiveMinimum": 0 },
          "levels": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["parallel", "number", "warmup"],
              "properties": {
                "parallel": { "description": "Closed-loop concurrency.", "type": "integer", "minimum": 1 },
                "number": { "description": "Measured requests, or conversations for a multi-turn workload.", "type": "integer", "minimum": 1 },
                "warmup": { "description": "Unmeasured requests sent first.", "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      },
      "IntelligencePlanItem": {
        "description": "One rule-scored benchmark. No judge model is involved. The score only shows that the engine still computes the model correctly.",
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "benchmark", "expected_samples", "sandbox", "metric"],
        "properties": {
          "id": { "$ref": "#/components/schemas/Text" },
          "benchmark": { "description": "The EvalScope benchmark name.", "$ref": "#/components/schemas/Text" },
          "limit": { "description": "Score only the first N samples. Omitted means all of them.", "type": "integer", "minimum": 1 },
          "expected_samples": { "type": "integer", "minimum": 1 },
          "sandbox": { "description": "Whether generated code runs in the Docker sandbox.", "type": "boolean" },
          "metric": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "aggregation", "dimensions"],
            "properties": {
              "name": { "$ref": "#/components/schemas/Text" },
              "aggregation": { "$ref": "#/components/schemas/Text" },
              "dimensions": { "type": "object", "additionalProperties": { "type": ["string", "number"] } }
            }
          }
        }
      },
      "EvaluationDefinition": {
        "description": "A repository-owned evaluation, stored at evaluations/<evaluation_id>/evaluation.json. Experiments select it by EvaluationReference and cannot change it. A draft keeps unresolved fields as null and cannot be used for formal runs. A released definition has no null, and a driver script.",
        "type": "object",
        "additionalProperties": false,
        "required": ["evaluation_id", "status", "description", "result_schema", "harness", "datasets", "task_ids", "seed", "limits", "cache_policy", "sampling_settings", "scripts"],
        "properties": {
          "evaluation_id": { "$ref": "#/components/schemas/EvaluationId" },
          "status": { "enum": ["draft", "released"] },
          "description": { "$ref": "#/components/schemas/Text" },
          "result_schema": {
            "description": "The result document the scripts emit: EvaluationResult for performance evaluations, ConformanceResult for endpoint conformance evaluations.",
            "enum": ["EvaluationResult", "ConformanceResult"]
          },
          "harness": {
            "description": "The tool or agent harness that drives the endpoint under test, with its exact version, or not applicable when the driver script talks to the endpoint directly.",
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "version"],
                "properties": {
                  "name": { "$ref": "#/components/schemas/NullableText" },
                  "version": { "$ref": "#/components/schemas/NullableText" }
                }
              },
              { "$ref": "#/components/schemas/NotApplicable" }
            ]
          },
          "datasets": {
            "description": "The external datasets, each pinned by the hashes of the files the evaluation reads, or not applicable when the workload is built into the scripts.",
            "anyOf": [
              {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/components/schemas/DatasetPin" }
              },
              { "$ref": "#/components/schemas/NotApplicable" }
            ]
          },
          "task_ids": {
            "description": "Exact task identifiers, or for a conformance evaluation the ids of its checks.",
            "type": ["array", "null"],
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/components/schemas/Text" }
          },
          "seed": { "type": ["integer", "null"] },
          "limits": {
            "type": "object",
            "additionalProperties": false,
            "required": ["context_window", "max_output_tokens_per_request", "timeout_seconds_per_task", "request_concurrency"],
            "properties": {
              "context_window": { "type": ["integer", "null"], "minimum": 1 },
              "max_output_tokens_per_request": { "type": ["integer", "null"], "minimum": 1 },
              "timeout_seconds_per_task": { "type": ["number", "null"], "exclusiveMinimum": 0 },
              "request_concurrency": { "type": ["integer", "null"], "minimum": 1 }
            }
          },
          "cache_policy": { "$ref": "#/components/schemas/NullableText" },
          "sampling_settings": { "anyOf": [{ "$ref": "#/components/schemas/ScalarSettings" }, { "type": "null" }] },
          "plan": {
            "description": "What a performance evaluation measures: the throughput workloads, the rule-scored intelligence benchmarks, and the sandbox for generated code. The driver builds every EvalScope invocation from it.",
            "type": "object",
            "additionalProperties": false,
            "required": ["throughput", "intelligence", "sandbox"],
            "properties": {
              "throughput": { "type": "array", "minItems": 1, "items": { "$ref": "#/components/schemas/ThroughputPlanItem" } },
              "intelligence": { "type": "array", "minItems": 1, "items": { "$ref": "#/components/schemas/IntelligencePlanItem" } },
              "sandbox": {
                "type": "object",
                "additionalProperties": false,
                "required": ["engine", "image", "network", "memory", "cpus"],
                "properties": {
                  "engine": { "const": "docker" },
                  "image": { "description": "Image pinned by digest.", "type": "string", "pattern": "@sha256:[0-9a-f]{64}$" },
                  "network": { "const": "disabled" },
                  "memory": { "$ref": "#/components/schemas/Text" },
                  "cpus": { "type": "number", "exclusiveMinimum": 0 }
                }
              }
            }
          },
          "scripts": {
            "type": ["array", "null"],
            "minItems": 1,
            "items": { "$ref": "#/components/schemas/EvaluationScript" }
          }
        },
        "allOf": [
          {
            "if": { "required": ["status"], "properties": { "status": { "const": "released" } } },
            "then": {
              "$ref": "#/components/schemas/NoNullValues",
              "properties": {
                "scripts": {
                  "contains": { "required": ["role"], "properties": { "role": { "const": "driver" } } }
                }
              }
            }
          }
        ]
      },
      "EvaluationResult": {
        "description": "The result document the pinned evaluation scripts emit for one baseline or candidate engine, measured serially on the same device. Do not edit it by hand.",
        "type": "object",
        "additionalProperties": false,
        "required": ["evaluation", "role", "engine_name", "environment", "runtime_revision", "artifacts", "commands", "settings", "repetitions", "metrics", "throughput", "resources", "quality"],
        "properties": {
          "evaluation": { "$ref": "#/components/schemas/EvaluationReference" },
          "environment": {
            "description": "What was actually observed, which may differ from the contract. Record deviations rather than hiding them.",
            "type": "object",
            "additionalProperties": false,
            "required": ["hardware_model", "os_version", "toolchain", "power_mode", "thermal_observations", "exclusive_gpu", "deviations_from_contract"],
            "properties": {
              "hardware_model": { "$ref": "#/components/schemas/Text" },
              "os_version": { "$ref": "#/components/schemas/Text" },
              "toolchain": { "$ref": "#/components/schemas/Text" },
              "power_mode": { "$ref": "#/components/schemas/Text" },
              "thermal_observations": { "$ref": "#/components/schemas/Text" },
              "exclusive_gpu": { "type": "boolean" },
              "deviations_from_contract": {
                "description": "Include any CPU fallback, offloading, SSD streaming, or multi-host participation.",
                "type": "array",
                "items": { "$ref": "#/components/schemas/Text" }
              }
            }
          },
          "role": { "enum": ["baseline", "candidate"] },
          "engine_name": { "$ref": "#/components/schemas/Text" },
          "runtime_revision": { "$ref": "#/components/schemas/CommitOrUnavailable" },
          "artifacts": {
            "description": "Hashes of the deployed executables and kernels. A checkout commit does not prove the deployed build.",
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/components/schemas/HashedArtifact" }
          },
          "commands": { "type": "array", "minItems": 1, "items": { "$ref": "#/components/schemas/Text" } },
          "settings": {
            "description": "Settings actually used, such as precision, speculation, caching, and memory limits.",
            "$ref": "#/components/schemas/ScalarSettings"
          },
          "repetitions": {
            "description": "Every cold-load, warm-up, and formal repetition, including failures.",
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["phase", "outcome"],
              "properties": {
                "phase": { "enum": ["cold-load", "warm-up", "formal"] },
                "outcome": { "enum": ["succeeded", "failed", "timed-out", "interrupted"] },
                "failure_description": { "$ref": "#/components/schemas/Text" }
              },
              "allOf": [
                {
                  "if": { "required": ["outcome"], "properties": { "outcome": { "enum": ["failed", "timed-out", "interrupted"] } } },
                  "then": { "required": ["failure_description"] }
                }
              ]
            }
          },
          "metrics": { "$ref": "#/components/schemas/Metrics" },
          "throughput": {
            "description": "The throughput measurement of every workload level, the main result. The run-level metrics are the headline values of the single-stream workloads. Empty when the throughput part was not run.",
            "type": "array",
            "items": { "$ref": "#/components/schemas/ThroughputResult" }
          },
          "resources": {
            "type": "object",
            "additionalProperties": false,
            "required": ["peak_memory_gib", "swap_out_delta_bytes"],
            "properties": {
              "peak_memory_gib": { "anyOf": [{ "type": "number", "minimum": 0 }, { "$ref": "#/components/schemas/NotObtained" }] },
              "swap_out_delta_bytes": {
                "description": "Whole-machine swap-out delta over bracketed boundaries. It is not attributed to a process without evidence.",
                "anyOf": [{ "type": "integer", "minimum": 0 }, { "$ref": "#/components/schemas/NotObtained" }]
              }
            }
          },
          "quality": {
            "description": "Intelligence checks. Rule-scored benchmark results show that the engine still computes the model correctly. They are compared with a baseline engine of the same model, not with an absolute floor, and are not numerical equivalence.",
            "type": "object",
            "additionalProperties": false,
            "required": ["intelligence"],
            "properties": {
              "intelligence": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["benchmarks", "complete", "negative_control_verified", "restricted_environment"],
                    "properties": {
                      "benchmarks": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["benchmark_id", "metric", "score", "num_samples", "stderr"],
                          "properties": {
                            "benchmark_id": { "$ref": "#/components/schemas/Text" },
                            "metric": { "$ref": "#/components/schemas/Text" },
                            "score": { "type": "number", "minimum": 0, "maximum": 1 },
                            "num_samples": { "description": "The denominator, including samples the model failed to answer.", "type": "integer", "minimum": 1 },
                            "stderr": { "description": "Standard error of a proportion, sqrt(score * (1 - score) / num_samples).", "type": "number", "minimum": 0 }
                          }
                        }
                      },
                      "complete": { "description": "Every benchmark in the pinned plan was scored on its expected samples.", "type": "boolean" },
                      "negative_control_verified": { "type": "boolean" },
                      "restricted_environment": {
                        "description": "True only if the control showed that generated programs ran without network access and with bounded resources.",
                        "type": "boolean"
                      }
                    }
                  },
                  { "$ref": "#/components/schemas/NotObtained" }
                ]
              }
            }
          }
        }
      },
      "Metrics": {
        "description": "Run-level summaries. Per-request native timings, token counts, cache hits, and request IDs stay in the referenced per-request evidence.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "formal_repetitions", "preliminary", "prefill", "decode", "client_ttft_median_seconds",
          "requests_reconciled", "per_request_evidence"
        ],
        "properties": {
          "formal_repetitions": { "type": "integer", "minimum": 0 },
          "preliminary": { "description": "A single cohort is preliminary evidence, not a stability study.", "type": "boolean" },
          "prefill": { "anyOf": [{ "$ref": "#/components/schemas/ThroughputAggregate" }, { "$ref": "#/components/schemas/NotObtained" }] },
          "decode": { "anyOf": [{ "$ref": "#/components/schemas/ThroughputAggregate" }, { "$ref": "#/components/schemas/NotObtained" }] },
          "client_ttft_median_seconds": {
            "description": "The median time from dispatch to the first output token of the 2k-token prefill workload, as EvalScope measures it.",
            "anyOf": [{ "type": "number", "minimum": 0 }, { "$ref": "#/components/schemas/NotObtained" }]
          },
          "requests_reconciled": {
            "description": "Every throughput request in the formal passes succeeded and reached its target input and output lengths. Metrics are not complete until they do.",
            "type": "boolean"
          },
          "per_request_evidence": { "$ref": "#/components/schemas/EvidenceRef" }
        },
        "allOf": [
          {
            "if": { "required": ["formal_repetitions"], "properties": { "formal_repetitions": { "maximum": 1 } } },
            "then": { "properties": { "preliminary": { "const": true } } }
          }
        ]
      },
      "ThroughputAggregate": {
        "description": "Throughput as a ratio of sums, never the mean of per-request speeds. The value must equal total_tokens divided by total_seconds; JSON Schema cannot check that arithmetic.",
        "type": "object",
        "additionalProperties": false,
        "required": ["basis", "total_tokens", "total_seconds", "tokens_per_second"],
        "properties": {
          "basis": {
            "description": "Decode definitions are never mixed. For n-minus-1-intervals, total_tokens is the sum of N-1 over requests with at least two output tokens. Native command-level metrics are never relabeled N-1.",
            "enum": ["processed-input-tokens", "n-minus-1-intervals", "native-command-timing", "native-speculative-multi-token"]
          },
          "total_tokens": { "type": "integer", "minimum": 0 },
          "total_seconds": { "type": "number", "exclusiveMinimum": 0 },
          "tokens_per_second": { "type": "number", "minimum": 0 }
        }
      },
      "ThroughputResult": {
        "description": "The measurement of one workload level, summed over the formal passes whose requests all met the workload's gates (every request succeeded, reached its target input length, and produced exactly its target output length). Prefill is processed input tokens over EvalScope's time to first token. Decode is output tokens minus one over its time per output token. Output and total throughput are tokens over the test duration. All are ratios of sums.",
        "type": "object",
        "additionalProperties": false,
        "required": ["workload_id", "kind", "concurrency", "input_tokens", "output_tokens", "requests", "succeeded_requests", "prefill", "decode", "ttft_median_seconds", "output_tokens_per_second", "total_tokens_per_second", "requests_per_second", "cache_hit_ratio"],
        "properties": {
          "workload_id": { "$ref": "#/components/schemas/Text" },
          "kind": { "enum": ["prefill", "decode", "concurrency", "multi-turn"] },
          "concurrency": { "description": "Closed-loop concurrent requests, or conversations for a multi-turn workload.", "type": "integer", "minimum": 1 },
          "input_tokens": { "description": "Target prompt tokens. For a multi-turn workload, the tokens added by each turn.", "type": "integer", "minimum": 1 },
          "output_tokens": { "type": "integer", "minimum": 1 },
          "requests": { "description": "Formal requests dispatched, including failures.", "type": "integer", "minimum": 0 },
          "succeeded_requests": { "type": "integer", "minimum": 0 },
          "prefill": { "anyOf": [{ "$ref": "#/components/schemas/ThroughputAggregate" }, { "$ref": "#/components/schemas/NotObtained" }] },
          "decode": { "anyOf": [{ "$ref": "#/components/schemas/ThroughputAggregate" }, { "$ref": "#/components/schemas/NotObtained" }] },
          "ttft_median_seconds": { "description": "Median over passes of the per-pass median time to the first token.", "anyOf": [{ "type": "number", "minimum": 0 }, { "$ref": "#/components/schemas/NotObtained" }] },
          "output_tokens_per_second": { "description": "Aggregate output tokens over the test duration, including ramp-up and ramp-down.", "anyOf": [{ "type": "number", "minimum": 0 }, { "$ref": "#/components/schemas/NotObtained" }] },
          "total_tokens_per_second": { "description": "Input plus output tokens over the test duration.", "anyOf": [{ "type": "number", "minimum": 0 }, { "$ref": "#/components/schemas/NotObtained" }] },
          "requests_per_second": { "anyOf": [{ "type": "number", "minimum": 0 }, { "$ref": "#/components/schemas/NotObtained" }] },
          "cache_hit_ratio": { "description": "Cached input tokens over input tokens as the engine reports them. Not obtained when the engine reports no cached tokens.", "anyOf": [{ "type": "number", "minimum": 0, "maximum": 1 }, { "$ref": "#/components/schemas/NotObtained" }] },
          "first_turn_ttft_seconds": { "description": "Mean time to the first token of the cold first turn of a multi-turn workload.", "type": "number", "minimum": 0 },
          "subsequent_turn_ttft_seconds": { "description": "Mean time to the first token of the later turns, which can hit the prefix cache.", "type": "number", "minimum": 0 },
          "variability": {
            "description": "The workload's headline tokens per second for each pass that met the gates, and their sample standard deviation.",
            "type": "object",
            "additionalProperties": false,
            "required": ["metric", "values", "sample_stddev"],
            "properties": {
              "metric": { "$ref": "#/components/schemas/Text" },
              "values": { "type": "array", "minItems": 1, "items": { "type": "number", "minimum": 0 } },
              "sample_stddev": { "anyOf": [{ "type": "number", "minimum": 0 }, { "$ref": "#/components/schemas/NotObtained" }] }
            }
          }
        }
      },
      "ConformanceCheckResult": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "api", "level", "outcome", "requests"],
        "properties": {
          "check_id": { "$ref": "#/components/schemas/Text" },
          "api": { "enum": ["openai-chat", "openai-responses", "anthropic-messages"] },
          "level": { "description": "A required check must pass for the endpoint to be conformant. An advisory check is recorded but does not decide it.", "enum": ["required", "advisory"] },
          "outcome": { "description": "skip means the feature is unsupported or the check was inconclusive; error means the check could not run to a verdict.", "enum": ["pass", "fail", "skip", "error"] },
          "requests": { "description": "Requests first issued by this check. Checks that share a response count it once.", "type": "integer", "minimum": 0 },
          "detail": { "$ref": "#/components/schemas/Text" }
        },
        "allOf": [
          {
            "if": { "required": ["outcome"], "properties": { "outcome": { "enum": ["fail", "skip", "error"] } } },
            "then": { "required": ["detail"] }
          }
        ]
      },
      "ConformanceResult": {
        "description": "The result document of an endpoint conformance evaluation. Checks validate structure and protocol invariants, not model quality. An endpoint is conformant only for a complete run whose evaluator passed its negative control; JSON Schema cannot check that the summary counts match the checks.",
        "type": "object",
        "additionalProperties": false,
        "required": ["evaluation", "engine_name", "endpoint", "started_at", "ended_at", "runtime_revision", "artifacts", "identity_verification", "checks", "summary", "complete", "cost", "negative_control"],
        "properties": {
          "evaluation": { "$ref": "#/components/schemas/EvaluationReference" },
          "engine_name": { "$ref": "#/components/schemas/Text" },
          "endpoint": {
            "description": "Only the scheme and whether the host is loopback are recorded, never a machine address or credential.",
            "type": "object",
            "additionalProperties": false,
            "required": ["scheme", "host_class", "model"],
            "properties": {
              "scheme": { "enum": ["http", "https"] },
              "host_class": { "enum": ["loopback", "remote"] },
              "model": { "$ref": "#/components/schemas/Text" }
            }
          },
          "started_at": { "type": "string", "format": "date-time" },
          "ended_at": { "type": "string", "format": "date-time" },
          "runtime_revision": { "$ref": "#/components/schemas/CommitOrUnavailable" },
          "artifacts": {
            "description": "Deployed engine artifacts when the operator supplied them. A conformance run observes only the HTTP endpoint.",
            "type": "array",
            "items": { "$ref": "#/components/schemas/HashedArtifact" }
          },
          "identity_verification": { "$ref": "#/components/schemas/Text" },
          "checks": { "type": "array", "minItems": 1, "items": { "$ref": "#/components/schemas/ConformanceCheckResult" } },
          "summary": {
            "type": "object",
            "additionalProperties": false,
            "required": ["total", "passed", "failed", "skipped", "errored", "required_failed", "conformant"],
            "properties": {
              "total": { "type": "integer", "minimum": 1 },
              "passed": { "type": "integer", "minimum": 0 },
              "failed": { "type": "integer", "minimum": 0 },
              "skipped": { "type": "integer", "minimum": 0 },
              "errored": { "type": "integer", "minimum": 0 },
              "required_failed": { "description": "Required checks that failed or errored.", "type": "integer", "minimum": 0 },
              "conformant": { "description": "True only when no required check failed or errored.", "type": "boolean" }
            }
          },
          "complete": { "description": "Every check in the pinned definition ran.", "type": "boolean" },
          "cost": {
            "type": "object",
            "additionalProperties": false,
            "required": ["requests", "prompt_tokens", "completion_tokens"],
            "properties": {
              "requests": { "type": "integer", "minimum": 0 },
              "prompt_tokens": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "$ref": "#/components/schemas/NotObtained" }] },
              "completion_tokens": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "$ref": "#/components/schemas/NotObtained" }] }
            }
          },
          "negative_control": {
            "description": "Whether the evaluator detected every known injected defect before this run.",
            "type": "object",
            "additionalProperties": false,
            "required": ["verified", "method"],
            "properties": {
              "verified": { "type": "boolean" },
              "method": { "$ref": "#/components/schemas/Text" }
            }
          },
          "evidence": { "$ref": "#/components/schemas/EvidenceRef" }
        },
        "allOf": [
          {
            "if": {
              "required": ["summary"],
              "properties": { "summary": { "required": ["conformant"], "properties": { "conformant": { "const": true } } } }
            },
            "then": {
              "properties": {
                "complete": { "const": true },
                "negative_control": { "properties": { "verified": { "const": true } } }
              }
            }
          }
        ]
      }
    }
  }
}
