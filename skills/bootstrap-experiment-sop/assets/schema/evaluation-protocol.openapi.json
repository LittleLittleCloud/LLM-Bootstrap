{
  "openapi": "3.1.0",
  "info": {
    "title": "LLM Bootstrap evaluation protocol schemas",
    "version": "1.0.0",
    "summary": "Structural schemas for repository-owned evaluation definitions and the report a run of an evaluation produces.",
    "description": "Machine-readable core of references/evaluation-protocol.md. This document defines no HTTP operations; the Schema Objects under components.schemas are the deliverable. Validate a definition at evaluations/<id>/evaluation.json against EvaluationDefinition and a report at experiments/<experiment-id>/evaluation/<subject>/<YYYYMMDD-HHMMSS>.json against EvaluationReport with any JSON Schema 2020-12 validator.\n\nEvaluations are owned by the LLM Bootstrap repository. Experiments select one by reference and never carry or change evaluation code. A report is what the evaluator page exports after a person gives it an endpoint, an optional token, and a model. It asks for nothing about the machine, the experiment, or the engine, so it holds none of them: it holds what was measured, the evaluator revision that measured it, and every measured request without prompts or model output. A missing measurement is null, never zero.\n\nThe prose protocol and the skills remain authoritative. A passing validation shows only the required shape. It does not show that scripts exist or match their hashes (the repository tests check that), that measurements are correct, or that the numbers agree with one another. Primitive schemas shared with the experiment protocol schema are kept identical, and a test enforces that."
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "paths": {},
  "components": {
    "schemas": {
      "Text": { "description": "Non-blank text.", "type": "string", "pattern": "\\S" },
      "Sha256": { "description": "Lowercase hexadecimal SHA-256 digest.", "type": "string", "pattern": "^[0-9a-f]{64}$" },
      "GitCommitSha": {
        "description": "Full 40-character Git commit SHA. Abbreviated SHAs, branches, and tags are not immutable revisions.",
        "type": "string",
        "pattern": "^[0-9a-f]{40}$"
      },
      "Timestamp": { "description": "RFC 3339 timestamp with an explicit UTC offset.", "type": "string", "format": "date-time" },
      "EvaluationId": {
        "description": "Kebab-case id that equals the directory name under evaluations/.",
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "EvaluationScript": {
        "description": "A script or code file that carries out part of the evaluation. It lives inside the evaluation's own directory in this repository and is checked against its hash. A driver runs the evaluation; an assertion evaluator verifies the driver against reference engines.",
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "path", "sha256"],
        "properties": {
          "role": { "enum": ["driver", "assertion-evaluator"] },
          "path": {
            "description": "Relative to evaluations/<evaluation_id>/. Absolute paths and parent traversal are not allowed.",
            "type": "string",
            "pattern": "^(?!/)(?!.*\\.\\.)[^\\\\]+$"
          },
          "sha256": { "$ref": "#/components/schemas/Sha256" }
        }
      },
      "Positive": { "type": "integer", "minimum": 1 },
      "TimeoutSeconds": { "description": "Per request.", "type": "number", "exclusiveMinimum": 0 },
      "EvaluationPlan": {
        "description": "What each test of the evaluation does. The evaluator builds every request from it, so an experiment cannot change a test.",
        "type": "object",
        "additionalProperties": false,
        "required": ["conform", "speed", "thinking", "decode", "prefill", "needle", "cache"],
        "properties": {
          "conform": {
            "type": "object", "additionalProperties": false, "required": ["timeout_seconds"],
            "properties": { "timeout_seconds": { "$ref": "#/components/schemas/TimeoutSeconds" } }
          },
          "speed": {
            "description": "Raw output speed from a short prompt: warm-up requests are excluded, each measured run is one value.",
            "type": "object", "additionalProperties": false, "required": ["warmup", "runs", "max_tokens", "timeout_seconds", "prompt"],
            "properties": {
              "warmup": { "type": "integer", "minimum": 0 }, "runs": { "$ref": "#/components/schemas/Positive" },
              "max_tokens": { "$ref": "#/components/schemas/Positive" }, "timeout_seconds": { "$ref": "#/components/schemas/TimeoutSeconds" },
              "prompt": { "$ref": "#/components/schemas/Text" }
            }
          },
          "thinking": {
            "description": "A medium reasoning task: name the row with the highest score. Asked with reasoning left on and with it switched off.",
            "type": "object", "additionalProperties": false, "required": ["questions", "rows", "warmup", "max_tokens", "timeout_seconds"],
            "properties": {
              "questions": { "$ref": "#/components/schemas/Positive" }, "rows": { "type": "integer", "minimum": 2 },
              "warmup": { "type": "integer", "minimum": 0 }, "max_tokens": { "$ref": "#/components/schemas/Positive" },
              "timeout_seconds": { "$ref": "#/components/schemas/TimeoutSeconds" }
            }
          },
          "decode": {
            "description": "Output speed at fixed output lengths.",
            "type": "object", "additionalProperties": false, "required": ["lengths", "runs", "warmup", "timeout_seconds", "prompt"],
            "properties": {
              "lengths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/components/schemas/Positive" } },
              "runs": { "$ref": "#/components/schemas/Positive" }, "warmup": { "type": "integer", "minimum": 0 },
              "timeout_seconds": { "$ref": "#/components/schemas/TimeoutSeconds" }, "prompt": { "$ref": "#/components/schemas/Text" }
            }
          },
          "prefill": {
            "description": "Input sizes that fit the context window, each with the needle pinned near the end.",
            "type": "object", "additionalProperties": false, "required": ["sizes", "needle_percent", "runs", "timeout_seconds"],
            "properties": {
              "sizes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/components/schemas/Positive" } },
              "needle_percent": { "type": "integer", "minimum": 0, "maximum": 100 }, "runs": { "$ref": "#/components/schemas/Positive" },
              "timeout_seconds": { "$ref": "#/components/schemas/TimeoutSeconds" }
            }
          },
          "needle": {
            "description": "A document filling a percent of the context window hides one access code at each position.",
            "type": "object", "additionalProperties": false, "required": ["fill_percent", "positions", "runs", "timeout_seconds"],
            "properties": {
              "fill_percent": { "type": "integer", "minimum": 10, "maximum": 100 },
              "positions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 0, "maximum": 100 } },
              "runs": { "$ref": "#/components/schemas/Positive" }, "timeout_seconds": { "$ref": "#/components/schemas/TimeoutSeconds" }
            }
          },
          "cache": {
            "description": "One question as a short prompt, a padded prompt, and a padded prompt with a nonce that defeats the cache.",
            "type": "object", "additionalProperties": false, "required": ["padded_tokens", "repeats", "timeout_seconds"],
            "properties": {
              "padded_tokens": { "$ref": "#/components/schemas/Positive" }, "repeats": { "$ref": "#/components/schemas/Positive" },
              "timeout_seconds": { "$ref": "#/components/schemas/TimeoutSeconds" }
            }
          }
        }
      },
      "EvaluationDefinition": {
        "description": "A repository-owned evaluation, stored at evaluations/<evaluation_id>/evaluation.json. Experiments select it by id, repository commit, and the hash of this file, and cannot change it. A draft cannot be used for formal runs. A released definition has at least one driver script, and every script exists and matches its hash.",
        "type": "object",
        "additionalProperties": false,
        "required": ["evaluation_id", "status", "description", "result_schema", "plan", "profiles", "scripts"],
        "properties": {
          "evaluation_id": { "$ref": "#/components/schemas/EvaluationId" },
          "status": { "enum": ["draft", "released"] },
          "description": { "$ref": "#/components/schemas/Text" },
          "result_schema": { "description": "The document a run produces.", "const": "EvaluationReport" },
          "plan": { "$ref": "#/components/schemas/EvaluationPlan" },
          "profiles": {
            "description": "Named reductions of the plan. A report of a profile other than the full plan is preliminary evidence. The full plan is the one without a name.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "quick": {
                "type": "object", "additionalProperties": false,
                "properties": {
                  "speed": { "type": "object" }, "thinking": { "type": "object" }, "decode": { "type": "object" },
                  "prefill": { "type": "object" }, "needle": { "type": "object" }, "cache": { "type": "object" }
                }
              }
            }
          },
          "scripts": { "type": "array", "items": { "$ref": "#/components/schemas/EvaluationScript" } }
        },
        "allOf": [
          {
            "if": { "required": ["status"], "properties": { "status": { "const": "released" } } },
            "then": {
              "properties": {
                "scripts": {
                  "minItems": 1,
                  "contains": { "required": ["role"], "properties": { "role": { "const": "driver" } } }
                }
              }
            }
          }
        ]
      },
      "Millis": { "description": "Milliseconds, null when not measured.", "type": ["number", "null"], "minimum": 0 },
      "Rate": { "description": "Tokens per second, null when not measured.", "type": ["number", "null"], "minimum": 0 },
      "Ratio": { "description": "A share between 0 and 1, null when there was nothing to divide.", "type": ["number", "null"], "minimum": 0, "maximum": 1 },
      "TestStatus": {
        "description": "complete: every planned request ran and succeeded. partial: some failed. error: all failed or the test could not run. cancelled: the person stopped the run. skipped: nothing in the plan fit this model.",
        "enum": ["complete", "partial", "error", "cancelled", "skipped"]
      },
      "RunError": { "type": "object", "required": ["ok", "error"], "properties": { "ok": { "const": false }, "error": { "$ref": "#/components/schemas/Text" } } },
      "ConformCheck": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "required", "status", "detail"],
        "properties": {
          "id": { "$ref": "#/components/schemas/Text" }, "title": { "$ref": "#/components/schemas/Text" }, "required": { "type": "boolean" },
          "status": { "enum": ["pass", "fail", "skip"] }, "detail": { "type": "string" }
        }
      },
      "ConformResult": {
        "description": "Whether the endpoint behaves like the API the other tests rely on. A failed required check means the other results cannot be trusted.",
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": { "$ref": "#/components/schemas/TestStatus" }, "error": { "type": "string" },
          "required_passed": { "type": "boolean" },
          "checks": { "type": "array", "items": { "$ref": "#/components/schemas/ConformCheck" } }
        },
        "allOf": [{ "if": { "properties": { "status": { "const": "complete" } }, "required": ["status"] }, "then": { "required": ["required_passed", "checks"] } }]
      },
      "SpeedRun": {
        "description": "tokens_per_second is completion tokens over the streaming time after the first delta, reasoning included.",
        "anyOf": [
          { "$ref": "#/components/schemas/RunError" },
          {
            "type": "object", "additionalProperties": false, "required": ["ok", "ttft_ms", "e2e_ms", "tokens_per_second", "completion_tokens", "reasoning_tokens"],
            "properties": {
              "ok": { "const": true }, "ttft_ms": { "$ref": "#/components/schemas/Millis" }, "e2e_ms": { "$ref": "#/components/schemas/Millis" },
              "tokens_per_second": { "$ref": "#/components/schemas/Rate" }, "completion_tokens": { "type": "integer", "minimum": 0 },
              "reasoning_tokens": { "type": "integer", "minimum": 0 }
            }
          }
        ]
      },
      "SpeedSummary": {
        "type": "object", "additionalProperties": false,
        "required": ["completed_runs", "failed_runs", "ttft_ms_p50", "ttft_ms_p90", "e2e_ms_p50", "e2e_ms_p90", "tokens_per_second_min", "tokens_per_second_p50", "tokens_per_second_max"],
        "properties": {
          "completed_runs": { "type": "integer", "minimum": 0 }, "failed_runs": { "type": "integer", "minimum": 0 },
          "ttft_ms_p50": { "$ref": "#/components/schemas/Millis" }, "ttft_ms_p90": { "$ref": "#/components/schemas/Millis" },
          "e2e_ms_p50": { "$ref": "#/components/schemas/Millis" }, "e2e_ms_p90": { "$ref": "#/components/schemas/Millis" },
          "tokens_per_second_min": { "$ref": "#/components/schemas/Rate" }, "tokens_per_second_p50": { "$ref": "#/components/schemas/Rate" },
          "tokens_per_second_max": { "$ref": "#/components/schemas/Rate" }
        }
      },
      "SpeedResult": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": { "$ref": "#/components/schemas/TestStatus" }, "error": { "type": "string" }, "config": { "type": "object" },
          "runs": { "type": "array", "items": { "$ref": "#/components/schemas/SpeedRun" } }, "summary": { "$ref": "#/components/schemas/SpeedSummary" }
        },
        "allOf": [{ "if": { "properties": { "status": { "enum": ["complete", "partial"] } }, "required": ["status"] }, "then": { "required": ["config", "runs", "summary"] } }]
      },
      "ThinkingRun": {
        "description": "A failed request counts as incorrect and non-compliant. answer is the response, cut to 80 characters.",
        "anyOf": [
          { "type": "object", "required": ["ok", "error", "correct", "compliant"], "properties": { "ok": { "const": false }, "error": { "$ref": "#/components/schemas/Text" }, "correct": { "const": false }, "compliant": { "const": false } } },
          {
            "type": "object", "additionalProperties": false, "required": ["ok", "correct", "compliant", "answer", "ttft_ms", "e2e_ms", "reasoning_tokens", "answer_tokens"],
            "properties": {
              "ok": { "const": true }, "correct": { "type": "boolean" }, "compliant": { "type": "boolean" }, "answer": { "type": "string", "maxLength": 80 },
              "ttft_ms": { "$ref": "#/components/schemas/Millis" }, "e2e_ms": { "$ref": "#/components/schemas/Millis" },
              "reasoning_tokens": { "type": "integer", "minimum": 0 }, "answer_tokens": { "type": "integer", "minimum": 0 }
            }
          }
        ]
      },
      "ThinkingSummary": {
        "type": "object", "additionalProperties": false,
        "required": ["attempted", "correct", "failed", "accuracy", "stderr", "format_compliance", "ttft_ms_p50", "ttft_ms_p95", "e2e_ms_p50", "e2e_ms_p95", "reasoning_tokens_p50", "answer_tokens_p50"],
        "properties": {
          "attempted": { "type": "integer", "minimum": 0 }, "correct": { "type": "integer", "minimum": 0 }, "failed": { "type": "integer", "minimum": 0 },
          "accuracy": { "$ref": "#/components/schemas/Ratio" },
          "stderr": { "description": "Standard error of a proportion, sqrt(accuracy * (1 - accuracy) / attempted).", "type": ["number", "null"], "minimum": 0 },
          "format_compliance": { "$ref": "#/components/schemas/Ratio" },
          "ttft_ms_p50": { "$ref": "#/components/schemas/Millis" }, "ttft_ms_p95": { "$ref": "#/components/schemas/Millis" },
          "e2e_ms_p50": { "$ref": "#/components/schemas/Millis" }, "e2e_ms_p95": { "$ref": "#/components/schemas/Millis" },
          "reasoning_tokens_p50": { "type": ["number", "null"], "minimum": 0 }, "answer_tokens_p50": { "type": ["number", "null"], "minimum": 0 }
        }
      },
      "ThinkingVariant": {
        "type": "object", "additionalProperties": false, "required": ["runs", "summary"],
        "properties": { "runs": { "type": "array", "items": { "$ref": "#/components/schemas/ThinkingRun" } }, "summary": { "$ref": "#/components/schemas/ThinkingSummary" } }
      },
      "ThinkingResult": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": { "$ref": "#/components/schemas/TestStatus" }, "error": { "type": "string" }, "config": { "type": "object" },
          "variants": {
            "description": "default leaves the endpoint's own thinking behavior; no-thinking sends chat_template_kwargs.enable_thinking = false.",
            "type": "object", "additionalProperties": false, "required": ["default"],
            "properties": { "default": { "$ref": "#/components/schemas/ThinkingVariant" }, "no-thinking": { "$ref": "#/components/schemas/ThinkingVariant" } }
          }
        },
        "allOf": [{ "if": { "properties": { "status": { "enum": ["complete", "partial"] } }, "required": ["status"] }, "then": { "required": ["config", "variants"] } }]
      },
      "DecodeRun": {
        "description": "decode_tokens_per_second is visible output tokens minus one over the time from the first to the last visible token; reasoning is excluded.",
        "anyOf": [
          { "$ref": "#/components/schemas/RunError" },
          {
            "type": "object", "additionalProperties": false,
            "required": ["ok", "ttft_ms", "decode_ms", "total_latency_ms", "decode_tokens_per_second", "visible_tokens", "reasoning_tokens", "reasoning_required", "fixed_length", "finish_reason"],
            "properties": {
              "ok": { "const": true }, "ttft_ms": { "$ref": "#/components/schemas/Millis" }, "decode_ms": { "$ref": "#/components/schemas/Millis" },
              "total_latency_ms": { "$ref": "#/components/schemas/Millis" }, "decode_tokens_per_second": { "$ref": "#/components/schemas/Rate" },
              "visible_tokens": { "type": "integer", "minimum": 0 }, "reasoning_tokens": { "type": "integer", "minimum": 0 },
              "reasoning_required": { "type": "boolean" }, "fixed_length": { "type": "boolean" }, "finish_reason": { "type": ["string", "null"] }
            }
          }
        ]
      },
      "DecodeSummary": {
        "type": "object", "additionalProperties": false,
        "required": [
          "completed_runs", "failed_runs", "decode_tokens_per_second_p50", "decode_tokens_per_second_p90", "ttft_ms_p50", "ttft_ms_p90",
          "total_latency_ms_p50", "total_latency_ms_p90", "visible_tokens_p50", "reasoning_tokens_p50", "reasoning_required", "fixed_length_applied"
        ],
        "properties": {
          "completed_runs": { "type": "integer", "minimum": 0 }, "failed_runs": { "type": "integer", "minimum": 0 },
          "decode_tokens_per_second_p50": { "$ref": "#/components/schemas/Rate" }, "decode_tokens_per_second_p90": { "$ref": "#/components/schemas/Rate" },
          "ttft_ms_p50": { "$ref": "#/components/schemas/Millis" }, "ttft_ms_p90": { "$ref": "#/components/schemas/Millis" },
          "total_latency_ms_p50": { "$ref": "#/components/schemas/Millis" }, "total_latency_ms_p90": { "$ref": "#/components/schemas/Millis" },
          "visible_tokens_p50": { "type": ["number", "null"], "minimum": 0 }, "reasoning_tokens_p50": { "type": ["number", "null"], "minimum": 0 },
          "reasoning_required": { "type": "boolean" },
          "fixed_length_applied": { "description": "min_tokens and ignore_eos were sent, so the model could not stop early.", "type": "boolean" }
        }
      },
      "DecodeResult": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": { "$ref": "#/components/schemas/TestStatus" }, "error": { "type": "string" }, "config": { "type": "object" },
          "lengths": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false, "required": ["output_tokens", "runs", "summary"],
              "properties": {
                "output_tokens": { "$ref": "#/components/schemas/Positive" },
                "runs": { "type": "array", "items": { "$ref": "#/components/schemas/DecodeRun" } }, "summary": { "$ref": "#/components/schemas/DecodeSummary" }
              }
            }
          }
        },
        "allOf": [{ "if": { "properties": { "status": { "enum": ["complete", "partial"] } }, "required": ["status"] }, "then": { "required": ["config", "lengths"] } }]
      },
      "RetrievalRun": {
        "description": "input_tokens_per_second is the prompt tokens the endpoint reported over the time to the first token, so it includes network and queueing.",
        "anyOf": [
          { "type": "object", "required": ["ok", "error", "correct", "compliant"], "properties": { "ok": { "const": false }, "error": { "$ref": "#/components/schemas/Text" }, "correct": { "const": false }, "compliant": { "const": false } } },
          {
            "type": "object", "additionalProperties": false, "required": ["ok", "correct", "compliant", "answer", "prompt_tokens", "ttft_ms", "e2e_ms", "input_tokens_per_second"],
            "properties": {
              "ok": { "const": true }, "correct": { "type": "boolean" }, "compliant": { "type": "boolean" }, "answer": { "type": "string", "maxLength": 40 },
              "prompt_tokens": { "type": ["integer", "null"], "minimum": 0 }, "ttft_ms": { "$ref": "#/components/schemas/Millis" },
              "e2e_ms": { "$ref": "#/components/schemas/Millis" }, "input_tokens_per_second": { "$ref": "#/components/schemas/Rate" }
            }
          }
        ]
      },
      "RetrievalSummary": {
        "type": "object", "additionalProperties": false,
        "required": ["attempted", "correct", "failed", "accuracy", "stderr", "format_compliance", "prompt_tokens_p50", "ttft_ms_p50", "ttft_ms_p90", "input_tokens_per_second_p50"],
        "properties": {
          "attempted": { "type": "integer", "minimum": 0 }, "correct": { "type": "integer", "minimum": 0 }, "failed": { "type": "integer", "minimum": 0 },
          "accuracy": { "$ref": "#/components/schemas/Ratio" }, "stderr": { "type": ["number", "null"], "minimum": 0 }, "format_compliance": { "$ref": "#/components/schemas/Ratio" },
          "prompt_tokens_p50": { "type": ["number", "null"], "minimum": 0 }, "ttft_ms_p50": { "$ref": "#/components/schemas/Millis" },
          "ttft_ms_p90": { "$ref": "#/components/schemas/Millis" }, "input_tokens_per_second_p50": { "$ref": "#/components/schemas/Rate" }
        }
      },
      "PrefillResult": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": { "$ref": "#/components/schemas/TestStatus" }, "error": { "type": "string" }, "config": { "type": "object" },
          "sizes": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false, "required": ["input_tokens", "status", "runs", "summary"],
              "properties": {
                "input_tokens": { "$ref": "#/components/schemas/Positive" }, "status": { "$ref": "#/components/schemas/TestStatus" }, "reason": { "type": "string" },
                "runs": { "type": "array", "items": { "$ref": "#/components/schemas/RetrievalRun" } }, "summary": { "$ref": "#/components/schemas/RetrievalSummary" }
              }
            }
          }
        },
        "allOf": [{ "if": { "properties": { "status": { "enum": ["complete", "partial", "skipped"] } }, "required": ["status"] }, "then": { "required": ["config", "sizes"] } }]
      },
      "NeedleResult": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": { "$ref": "#/components/schemas/TestStatus" }, "error": { "type": "string" }, "config": { "type": "object" },
          "positions": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false, "required": ["percent", "runs", "summary"],
              "properties": {
                "percent": { "type": "integer", "minimum": 0, "maximum": 100 },
                "runs": { "type": "array", "items": { "$ref": "#/components/schemas/RetrievalRun" } }, "summary": { "$ref": "#/components/schemas/RetrievalSummary" }
              }
            }
          },
          "summary": { "$ref": "#/components/schemas/RetrievalSummary" }
        },
        "allOf": [{ "if": { "properties": { "status": { "enum": ["complete", "partial"] } }, "required": ["status"] }, "then": { "required": ["config", "positions", "summary"] } }]
      },
      "CacheRequest": {
        "anyOf": [
          { "$ref": "#/components/schemas/RunError" },
          {
            "type": "object", "additionalProperties": false, "required": ["ok", "ttft_ms", "prompt_tokens", "cached_tokens", "correct", "e2e_ms"],
            "properties": {
              "ok": { "const": true }, "ttft_ms": { "$ref": "#/components/schemas/Millis" }, "prompt_tokens": { "type": ["integer", "null"], "minimum": 0 },
              "cached_tokens": { "description": "As the endpoint reports it; null when it reports none.", "type": ["integer", "null"], "minimum": 0 },
              "correct": { "type": "boolean" }, "e2e_ms": { "$ref": "#/components/schemas/Millis" }
            }
          }
        ]
      },
      "CacheVariant": {
        "type": "object", "additionalProperties": false, "required": ["cold", "warm", "summary"],
        "properties": {
          "cold": { "$ref": "#/components/schemas/CacheRequest" },
          "warm": { "type": "array", "items": { "$ref": "#/components/schemas/CacheRequest" } },
          "summary": {
            "type": "object", "additionalProperties": false,
            "required": ["cache_reported", "cache_hit_pct", "cold_ttft_ms", "warm_ttft_ms_p50", "ttft_reduction_pct", "prompt_tokens", "completed_runs", "failed_runs", "correct"],
            "properties": {
              "cache_reported": { "type": "boolean" },
              "cache_hit_pct": { "description": "Cached tokens over prompt tokens of the repeats, as the endpoint reports them.", "type": ["number", "null"], "minimum": 0, "maximum": 100 },
              "cold_ttft_ms": { "$ref": "#/components/schemas/Millis" }, "warm_ttft_ms_p50": { "$ref": "#/components/schemas/Millis" },
              "ttft_reduction_pct": { "type": ["number", "null"] }, "prompt_tokens": { "type": ["integer", "null"], "minimum": 0 },
              "completed_runs": { "type": "integer", "minimum": 0 }, "failed_runs": { "type": "integer", "minimum": 0 }, "correct": { "type": "integer", "minimum": 0 }
            }
          }
        }
      },
      "CacheResult": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": { "$ref": "#/components/schemas/TestStatus" }, "error": { "type": "string" }, "config": { "type": "object" },
          "variants": {
            "type": "object", "additionalProperties": false, "required": ["short", "padded", "busted"],
            "properties": {
              "short": { "$ref": "#/components/schemas/CacheVariant" }, "padded": { "$ref": "#/components/schemas/CacheVariant" },
              "busted": { "$ref": "#/components/schemas/CacheVariant" }
            }
          }
        },
        "allOf": [{ "if": { "properties": { "status": { "enum": ["complete", "partial"] } }, "required": ["status"] }, "then": { "required": ["config", "variants"] } }]
      },
      "EvaluationReport": {
        "description": "What one run of the evaluation measured for one model of one endpoint. It is exported by the evaluator page and stored at experiments/<experiment-id>/evaluation/<subject>/<YYYYMMDD-HHMMSS>.json, where the name is started_at in UTC and subject is candidate or the name of a baseline engine of the experiment. It pins the evaluation by id, repository commit, and definition hash, and must cite the evaluation of its experiment. Do not edit it by hand. The endpoint is recorded only as a class, never its address, and the token is never recorded. Only the tests that were selected appear under tests.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "report_version", "evaluation_id", "evaluation_revision", "evaluation_sha256", "started_at", "finished_at", "endpoint_class", "model",
          "profile", "seed", "context_window", "chars_per_token", "selected_tests", "status", "failures", "tests"
        ],
        "properties": {
          "report_version": { "const": 1 },
          "evaluation_id": { "$ref": "#/components/schemas/EvaluationId" },
          "evaluation_revision": { "$ref": "#/components/schemas/GitCommitSha" },
          "evaluation_sha256": { "$ref": "#/components/schemas/Sha256" },
          "build_dirty": { "description": "Present and true when the evaluator build had uncommitted changes, so evaluation_revision does not identify it.", "const": true },
          "started_at": { "$ref": "#/components/schemas/Timestamp" },
          "finished_at": { "$ref": "#/components/schemas/Timestamp" },
          "endpoint_class": { "description": "Where the endpoint is, as a class: loopback is this machine, private-network is a local network address, remote is anywhere else. The address itself is never recorded.", "enum": ["loopback", "private-network", "remote"] },
          "model": { "$ref": "#/components/schemas/Text" },
          "profile": { "description": "full is the whole plan; any other profile is a reduction and the report is preliminary evidence.", "enum": ["full", "quick"] },
          "seed": { "description": "Seeds the generated questions and documents, so a run can be reproduced.", "type": "string", "pattern": "^[0-9a-f]{8}$" },
          "context_window": {
            "description": "The window the long-context tests were sized against: reported by the endpoint's model list, or assumed when it reports none.",
            "type": "object", "additionalProperties": false, "required": ["tokens", "source"],
            "properties": { "tokens": { "$ref": "#/components/schemas/Positive" }, "source": { "enum": ["models-metadata", "assumed"] } }
          },
          "chars_per_token": { "description": "Characters per token of the generated documents, from one probe; null when the probe failed.", "type": ["number", "null"], "exclusiveMinimum": 0 },
          "compat": {
            "description": "Request fields the endpoint rejected and the evaluator then changed, such as max_completion_tokens in place of max_tokens.",
            "type": "object"
          },
          "selected_tests": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["conform", "speed", "thinking", "decode", "prefill", "needle", "cache"] } },
          "status": { "description": "complete only when every selected test is complete.", "enum": ["complete", "partial", "error", "cancelled"] },
          "failures": { "description": "One line for each selected test that was not complete.", "type": "array", "items": { "$ref": "#/components/schemas/Text" } },
          "tests": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "conform": { "$ref": "#/components/schemas/ConformResult" }, "speed": { "$ref": "#/components/schemas/SpeedResult" },
              "thinking": { "$ref": "#/components/schemas/ThinkingResult" }, "decode": { "$ref": "#/components/schemas/DecodeResult" },
              "prefill": { "$ref": "#/components/schemas/PrefillResult" }, "needle": { "$ref": "#/components/schemas/NeedleResult" },
              "cache": { "$ref": "#/components/schemas/CacheResult" }
            }
          }
        },
        "allOf": [
          {
            "if": { "required": ["status"], "properties": { "status": { "const": "complete" } } },
            "then": { "properties": { "failures": { "maxItems": 0 } } },
            "else": { "properties": { "failures": { "minItems": 1 } } }
          }
        ]
      }
    }
  }
}
