{
  "evaluation_id": "endpoint-bench",
  "status": "released",
  "description": "A quick benchmark of an OpenAI-compatible chat endpoint, run from a web page with only the endpoint URL and an optional token. It runs seven tests against one model: conform checks that the endpoint behaves like the API the other tests rely on; speed measures raw output speed from a short prompt; thinking asks a medium reasoning task with reasoning left on and switched off; decode measures output speed at fixed output lengths; prefill measures how fast long prompts are digested; needle hides one access code at several depths of a document that fills most of the context window; cache asks one question as a short prompt, a padded prompt, and a prompt with a nonce that defeats the cache. Time runs on the browser's monotonic clock and token counts come from the endpoint's reported usage. The report holds every measured request without prompts or model output.",
  "result_schema": "EvaluationReport",
  "plan": {
    "conform": {
      "timeout_seconds": 60
    },
    "speed": {
      "warmup": 1,
      "runs": 5,
      "max_tokens": 512,
      "timeout_seconds": 120,
      "prompt": "Output lowercase English words separated by single spaces.\nDo not use punctuation, numbers, headings, explanations, or line breaks.\nBegin immediately.\nContinue generating words without stopping or concluding until the generation is stopped externally."
    },
    "thinking": {
      "questions": 10,
      "rows": 30,
      "warmup": 1,
      "max_tokens": 4096,
      "timeout_seconds": 300
    },
    "decode": {
      "lengths": [
        100,
        1000,
        4000
      ],
      "runs": 3,
      "warmup": 1,
      "timeout_seconds": 300,
      "prompt": "Generate a continuous stream of lowercase English words separated by single spaces. Do not use punctuation, numbers, headings, explanations, or formatting. Begin immediately and continue generating until stopped."
    },
    "prefill": {
      "sizes": [
        10000,
        50000,
        100000,
        250000,
        500000,
        1000000
      ],
      "needle_percent": 90,
      "runs": 1,
      "timeout_seconds": 600
    },
    "needle": {
      "fill_percent": 90,
      "positions": [
        5,
        25,
        50,
        75,
        90
      ],
      "runs": 2,
      "timeout_seconds": 600
    },
    "cache": {
      "padded_tokens": 50000,
      "repeats": 5,
      "timeout_seconds": 300
    }
  },
  "profiles": {
    "quick": {
      "speed": {
