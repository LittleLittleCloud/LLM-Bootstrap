{
  "evaluation_id": "engine-api-conformance",
  "status": "released",
  "description": "Cheap endpoint conformance checks for OpenAI Chat Completions (non-streaming, streaming, and tool calling), OpenAI Responses, and Anthropic Messages. They also probe UTF-8 integrity in streams, reasoning separation, malformed requests, concurrent requests, client disconnects, prefix-cache consistency, and context overflow (the overflow checks need the served context window from --context-window and are skipped without it). They validate response structure and protocol invariants with tiny requests (temperature 0, at most 64 output tokens), not model quality. Run reasoning models with thinking disabled. Required checks decide conformance; advisory checks record common behavior that the APIs do not mandate. Before every run the driver repeats its negative control: a reference engine that must pass every check, and each injected fault, which must be caught.",
  "result_schema": "ConformanceResult",
  "harness": {
    "not_applicable": true,
    "reason": "The driver script sends HTTP requests to the endpoint directly; no agent harness is involved."
  },
  "datasets": {
    "not_applicable": true,
    "reason": "The checks and their prompts are built into the scripts; there is no external dataset."
  },
